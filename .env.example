# Copie para .env.local e preencha. Só variáveis públicas (VITE_*) entram no bundle do navegador.
# Service role, senha do banco e a chave da OpenAI NUNCA entram aqui nem na Vercel: ficam só nos
# segredos das Edge Functions do Supabase.
VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
